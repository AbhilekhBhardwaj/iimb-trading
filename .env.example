VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENGINE_WS_URL=

# PostHog analytics (optional). Leave blank to disable — the app silently
# no-ops analytics without a key. VITE_POSTHOG_HOST defaults to us.i.posthog.com.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Server/script-side only — used by scripts/provision-teams.ts.
# NEVER prefix these with VITE_ (that would expose the secret to the browser).
# SUPABASE_URL is optional; the script falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
