{
  "name": "iimb-trading",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && npm test --workspace @iimb-trading/engine",
    "test:app": "vitest run",
    "test:app:watch": "vitest",
    "test:engine": "npm test --workspace @iimb-trading/engine",
    "provision": "tsx scripts/provision-teams.ts",
    "trading:smoke": "tsx server/smoke-test.ts",
    "trading:margin-smoke": "tsx server/margin-smoke.ts",
    "trading:recovery-smoke": "tsx server/recovery-smoke.ts",
    "trading:commission-smoke": "tsx server/commission-smoke.ts",
    "api": "tsx server/api.ts",
    "round:start": "tsx server/round.ts start",
    "round:end": "tsx server/round.ts end",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.3.3",
    "lightweight-charts": "^5.2.0",
    "motion": "^12.42.2",
    "posthog-js": "^1.409.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.1",
    "recharts": "^3.10.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
